---
const featured = [
  {
    title: 'The Play That Goes Wrong',
    role: 'Live Mixer',
    date: 'May 2025',
    award: null,
  },
  {
    title: 'SCAD Sportsdesk',
    role: 'Live Mixer — Multi-cam Sports Broadcast',
    date: 'Feb 2025',
    award: 'NATAS Southeast Emmy® Nominated',
  },
  {
    title: 'Crazy For You',
    role: 'Sound Designer & Live Mixer',
    date: 'Mar 2022',
    award: null,
  },
];

const productionSound = [
  { title: 'Behind Closed Doors', date: 'Apr 2025' },
  { title: 'Dubbings & Dragons', date: 'Mar 2025' },
  { title: 'Daughter of The Sea', date: 'Apr 2024' },
  { title: 'He Loves Her', date: 'Apr 2024' },
  { title: 'Sins of The Father', date: 'Mar 2024' },
  { title: 'Kids Will Be Kids', date: 'Mar 2023' },
  { title: 'Splash', date: 'Mar 2023', award: 'Red Dot Sound Design Award' },
];

const awards = [
  { name: 'Red Dot Sound Design Award', detail: 'Production Mixer — Splash', year: '2023' },
  { name: 'Silver — Best Sound Design', detail: 'Rerecording Mixer — Souer Celeste, Independent Short Awards', year: '2025' },
  { name: 'NATAS Southeast Emmy® Nomination', detail: 'Multi-cam broadcast — SCAD Sportsdesk', year: '2025' },
];

const consoles = ['LAWo', 'Avid', 'Yamaha'];
const daws = ['Wwise', 'Reaper', 'Pro Tools', 'Ableton Live', 'Audacity'];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Devon Birdwell — Sound Designer & Live Mixer</title>
    <meta name="description" content="Devon Birdwell — sound designer, live mixer, and production sound mixer for live events, theatre, and broadcast. Atlanta, GA." />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <div class="preview-banner" id="preview-banner">
      PREVIEW BUILD — dashed boxes are yours to fill, Devon. Everything else is already live-ready.
    </div>

    <header class="hero">
      <div class="wrap">
        <p class="kicker">Atlanta, GA</p>
        <h1>Devon Birdwell</h1>
        <p class="role">Sound Designer &amp; Live Mixer</p>
        <p class="sub">Live theatre · Multi-cam broadcast · Production sound · Large-scale event staging</p>
        <div class="reel">
          <video controls preload="none" playsinline poster="/reel-poster.jpg">
            <source src="/reel.mp4" type="video/mp4" />
            Your browser doesn't support embedded video.
            <a href="/reel.mp4">Download the reel</a>.
          </video>
          <p class="reel-caption">Showreel — 70 seconds</p>
        </div>
      </div>
    </header>

    <main class="wrap">
      <!-- SELECTED WORK -->
      <section id="work">
        <h2><span class="tick">▍</span>Selected Work</h2>
        <div class="cards">
          {featured.map((c) => (
            <article class="card">
              <header>
                <h3>{c.title}</h3>
                <p class="mono meta">{c.role} · {c.date}</p>
                {c.award && <p class="award-badge">{c.award}</p>}
              </header>
              <div class="fill-slot">
                <p class="fill-label">YOURS TO FILL</p>
                <p>Venue + scale (house size, tour, festival) and 1–3 sentences on the sonic concept — what was the design idea, what problem did you solve?</p>
              </div>
              <div class="fill-slot slot-photo">
                <p class="fill-label">PHOTO SLOT</p>
                <p>A production shot from this show (+ photographer credit). A shot of you at the console is gold.</p>
              </div>
            </article>
          ))}
        </div>
      </section>

      <!-- AUDIO EXCERPTS -->
      <section id="audio">
        <h2><span class="tick">▍</span>Design Excerpts</h2>
        <p class="section-note">Titled cues that show the design detail the reel can't.</p>
        <div class="cards three">
          {[1, 2, 3].map(() => (
            <div class="fill-slot slot-audio">
              <p class="fill-label">AUDIO EXCERPT SLOT</p>
              <p>A short clip named by its dramatic function — e.g. <em>"Storm transition — Crazy For You"</em> — not "Track 1."</p>
            </div>
          ))}
        </div>
      </section>

      <!-- PRODUCTION SOUND -->
      <section id="production-sound">
        <h2><span class="tick">▍</span>Production Sound</h2>
        <ul class="credits">
          {productionSound.map((c) => (
            <li>
              <span class="credit-title">{c.title}</span>
              <span class="mono credit-role">Production Sound Mixer · {c.date}</span>
              {c.award && <span class="award-badge inline">{c.award}</span>}
            </li>
          ))}
        </ul>
      </section>

      <!-- AWARDS -->
      <section id="awards">
        <h2><span class="tick">▍</span>Recognition</h2>
        <ul class="awards">
          {awards.map((a) => (
            <li>
              <span class="award-name">{a.name}</span>
              <span class="award-detail">{a.detail}</span>
              <span class="mono award-year">{a.year}</span>
            </li>
          ))}
        </ul>
      </section>

      <!-- ABOUT -->
      <section id="about">
        <h2><span class="tick">▍</span>About</h2>
        <div class="about-grid">
          <div class="fill-slot slot-headshot">
            <p class="fill-label">HEADSHOT SLOT</p>
            <p>One decent photo of you.</p>
          </div>
          <div class="bio">
            <p>
              I'm a sound designer and live/production mixer with a B.F.A. in Sound Design
              from the Savannah College of Art &amp; Design and six-plus years across live
              theatre, multi-cam broadcast, film production sound, and large-scale event
              staging. I mix front-of-house, design for the stage, and hold a set together
              when it's rolling — fast decisions under pressure are the job.
            </p>
            <p>
              Currently with Rhino Staging in Atlanta, supporting corporate events,
              concerts, and festivals from rigging to showtime.
            </p>
          </div>
        </div>
      </section>

      <!-- SKILLS -->
      <section id="skills">
        <h2><span class="tick">▍</span>Consoles &amp; Tools</h2>
        <div class="skills-grid">
          <div>
            <h3 class="mono">CONSOLES</h3>
            <ul class="mono taglist">
              {consoles.map((s) => <li>{s}</li>)}
            </ul>
          </div>
          <div>
            <h3 class="mono">DAWs</h3>
            <ul class="mono taglist">
              {daws.map((s) => <li>{s}</li>)}
            </ul>
          </div>
          <div>
            <h3 class="mono">PRACTICE</h3>
            <ul class="mono taglist">
              <li>FOH / monitor mixing</li>
              <li>Production mixing</li>
              <li>System installation</li>
              <li>Console programming</li>
            </ul>
          </div>
        </div>
      </section>

      <!-- CONTACT -->
      <section id="contact">
        <h2><span class="tick">▍</span>Contact</h2>
        <p class="contact-line">
          <a class="btn" href="mailto:devonbirdwell@gmail.com">devonbirdwell@gmail.com</a>
          <a class="btn ghost" href="/Devon-Birdwell-Resume.pdf" download>Resume (PDF)</a>
        </p>
        <div class="fill-slot slot-links">
          <p class="fill-label">LINKS SLOT</p>
          <p>LinkedIn / socials you want public, plus anything already hosted (SoundCloud, Vimeo, YouTube).</p>
        </div>
      </section>
    </main>

    <footer>
      <p class="mono">© 2026 Devon Birdwell · Atlanta, GA</p>
    </footer>

    <style>
      :root {
        --bg: #0a0a0c;
        --panel: #121216;
        --ink: #f2efe9;
        --dim: #9a958c;
        --accent: #e0a63c;
        --line: #26262c;
      }
      * { margin: 0; padding: 0; box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body {
        background: var(--bg);
        color: var(--ink);
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;
        line-height: 1.6;
      }
      .mono { font-family: 'SF Mono', SFMono-Regular, ui-monospace, Menlo, Consolas, monospace; }
      .wrap { max-width: 960px; margin: 0 auto; padding: 0 1.25rem; }

      .preview-banner {
        background: var(--accent);
        color: #1a1405;
        text-align: center;
        padding: 0.5rem 1rem;
        font-size: 0.85rem;
        font-weight: 600;
      }

      .hero { padding: 4.5rem 0 3rem; border-bottom: 1px solid var(--line); }
      .kicker { color: var(--accent); font-size: 0.85rem; letter-spacing: 0.25em; text-transform: uppercase; }
      .hero h1 { font-size: clamp(2.6rem, 7vw, 4.5rem); font-weight: 800; letter-spacing: -0.02em; line-height: 1.05; }
      .role { font-size: clamp(1.2rem, 3vw, 1.6rem); color: var(--ink); margin-top: 0.4rem; font-weight: 300; }
      .sub { color: var(--dim); margin-top: 0.6rem; font-size: 0.95rem; }
      .reel { margin-top: 2.25rem; }
      .reel video { width: 100%; border-radius: 8px; border: 1px solid var(--line); display: block; background: #000; }
      .reel-caption { color: var(--dim); font-size: 0.8rem; margin-top: 0.5rem; text-align: right; }

      section { padding: 3.25rem 0 0.5rem; }
      h2 { font-size: 1.5rem; letter-spacing: 0.01em; margin-bottom: 1.25rem; }
      .tick { color: var(--accent); }
      .section-note { color: var(--dim); margin: -0.75rem 0 1.25rem; font-size: 0.9rem; }

      .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(270px, 1fr)); gap: 1rem; }
      .card { background: var(--panel); border: 1px solid var(--line); border-radius: 8px; padding: 1.25rem; }
      .card h3 { font-size: 1.15rem; }
      .meta { color: var(--dim); font-size: 0.8rem; margin: 0.35rem 0 0.5rem; }
      .award-badge {
        display: inline-block; background: rgba(224, 166, 60, 0.12); color: var(--accent);
        border: 1px solid rgba(224, 166, 60, 0.4); border-radius: 4px;
        font-size: 0.72rem; padding: 0.15rem 0.5rem; letter-spacing: 0.04em; margin-bottom: 0.4rem;
      }
      .award-badge.inline { margin: 0; }

      .fill-slot {
        border: 1.5px dashed rgba(224, 166, 60, 0.45);
        border-radius: 6px; padding: 0.9rem 1rem; margin-top: 0.9rem;
        color: var(--dim); font-size: 0.85rem; background: rgba(224, 166, 60, 0.03);
      }
      .fill-label { color: var(--accent); font-size: 0.7rem; letter-spacing: 0.18em; font-weight: 700; margin-bottom: 0.3rem; }

      .credits { list-style: none; }
      .credits li {
        display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.75rem;
        padding: 0.7rem 0; border-bottom: 1px solid var(--line);
      }
      .credit-title { font-weight: 600; }
      .credit-role { color: var(--dim); font-size: 0.78rem; }

      .awards { list-style: none; }
      .awards li { display: flex; flex-wrap: wrap; gap: 0.75rem; align-items: baseline; padding: 0.7rem 0; border-bottom: 1px solid var(--line); }
      .award-name { color: var(--accent); font-weight: 700; }
      .award-detail { color: var(--dim); }
      .award-year { color: var(--dim); font-size: 0.78rem; margin-left: auto; }

      .about-grid { display: grid; grid-template-columns: 200px 1fr; gap: 1.5rem; align-items: start; }
      .slot-headshot { min-height: 220px; display: flex; flex-direction: column; justify-content: center; }
      .bio p + p { margin-top: 0.9rem; }

      .skills-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 1.5rem; }
      .skills-grid h3 { color: var(--accent); font-size: 0.8rem; letter-spacing: 0.15em; margin-bottom: 0.6rem; }
      .taglist { list-style: none; }
      .taglist li { padding: 0.25rem 0; border-bottom: 1px dotted var(--line); font-size: 0.85rem; color: var(--ink); }

      .contact-line { display: flex; gap: 0.75rem; flex-wrap: wrap; margin-bottom: 1rem; }
      .btn {
        display: inline-block; background: var(--accent); color: #1a1405; text-decoration: none;
        padding: 0.6rem 1.2rem; border-radius: 6px; font-weight: 700; font-size: 0.9rem;
      }
      .btn.ghost { background: transparent; color: var(--accent); border: 1px solid var(--accent); }
      .btn:hover { filter: brightness(1.1); }

      footer { border-top: 1px solid var(--line); margin-top: 3.5rem; padding: 1.5rem 1.25rem; text-align: center; color: var(--dim); font-size: 0.75rem; }

      @media (max-width: 640px) {
        .about-grid { grid-template-columns: 1fr; }
        .award-year { margin-left: 0; }
      }
    </style>
  </body>
</html>
